{
    "name": "zarkasi/yii2-dynamicform",
    "description": "It Is Forked Form wbraganca/yii2-dynamicform",
    "keywords": [
        "wbraganca",
        "yii2",
        "extension",
        "widget",
        "yii2-dynamicform",
        "copy DOM element",
        "yii2 dynamic form",
        "tabular input",
        "forked from wbraganca",
        "updated version wbraganca"
    ],
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/wbraganca/yii2-dynamicform/issues",
        "wiki": "https://github.com/wbraganca/yii2-dynamicform/wiki/",
        "source": "https://github.com/wbraganca/yii2-dynamicform"
    },
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Wanderson Bragança",
            "email": "wanderson.wbc@gmail.com",
            "homepage": "http://wbraganca.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "yiisoft/yii2": "~2.0.5",
        "symfony/css-selector": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yidas/yii2-composer-bower-skip": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "wbraganca\\dynamicform\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "yidas/yii2-composer-bower-skip": true,
            "yiisoft/yii2-composer": true
        }
    }
}
